# TracePilot Environment Configuration

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# AI Provider (Google Gemini or OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=models/text-embedding-004

# Storage Mode: "sqlite" for standalone zero-daemon local dev, "postgres" for production
STORAGE_BACKEND=sqlite
DATABASE_URL=sqlite+aiosqlite:///./data/tracepilot.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tracepilot

# Graph Mode: "networkx" for standalone zero-daemon local dev, "neo4j" for production
GRAPH_BACKEND=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Streaming & Cache Mode: "memory" for standalone local dev, "redis" for production
STREAM_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma
